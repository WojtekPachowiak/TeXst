# Stage 1: Build the Go binary
FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY goworkspace/worker/go.mod goworkspace/worker/go.sum .
RUN go mod download

COPY goworkspace/shared/go.mod goworkspace/shared/go.sum .
RUN go mod download

COPY ./goworkspace .

RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -o work worker

# Stage 2: Runtime image with pandoc/latex
FROM pandoc/typst:3.9

RUN apk add --no-cache imagemagick ghostscript

# Copy the binary from the builder stage
COPY --from=builder /app/work /usr/local/bin/work

# Expose the port your work listens on (adjust if needed)
# EXPOSE 8080

# Start the work
ENTRYPOINT []
CMD ["work"]
