ROOT_DIR=$ROOT_DIR

GLOBAL_APP_DOMAIN=app.$GLOBAL_DOMAIN
GLOBAL_AUTH_DOMAIN=auth.$GLOBAL_DOMAIN

TF_VAR_domain="${GLOBAL_DOMAIN}"

REDIS_STREAM_LATEX='stream:latex'
REDIS_STREAM_TYPST='stream:typst'
REDIS_CONSUMER_GROUP_LATEX='workers-latex'
REDIS_CONSUMER_GROUP_TYPST='workers-typst'
REDIS_ADDR='redis:6379'
REDIS_PUBSUB_CHANNEL_PREFIX='job:events:'

MINIO_EXTERNAL_ENDPOINT=$GLOBAL_APP_DOMAIN
MINIO_INTERNAL_ENDPOINT='minio:9002'
MINIO_ROOT_USER='minioadmin'
MINIO_ROOT_PASSWORD='minioadmin'
MINIO_USE_SSL='true'
MINIO_BUCKET_NAME='rendered-documents'
 
AUTHENTIK_REDIS__HOST=redis
AUTHENTIK_POSTGRESQL__HOST=postgres
AUTHENTIK_ERROR_REPORTING__ENABLED=false

GF_AUTH_ANONYMOUS_ENABLED=false
